# =============================================================================
# .env.example — copie para .env e ajuste. TODA configuração vem daqui.
#
# TOPOLOGIAS
#   1) Local (tudo na mesma máquina)
#        ROLE=local   CLUSTER_HOST=localhost   BIND_ADDR=127.0.0.1
#   2) VPS + notebook via VPN (experimento definitivo)
#        VPS     : ROLE=server  CLUSTER_HOST=<IP da VPS na VPN>  BIND_ADDR=<IP da VPS na VPN>
#        Notebook: ROLE=client  CLUSTER_HOST=<IP da VPS na VPN>  KUBECONFIG_FILE=kubeconfig-vpn.yaml
#      O cluster roda na VPS; k6 e análise rodam no notebook (sem disputar CPU com o cluster).
# =============================================================================

# ── Papel desta máquina: local | server | client ────────────────────────────
ROLE=local

# ── Endereço do cluster (do ponto de vista de quem gera carga) ──────────────
#   local: localhost | VPN WireGuard: 10.0.0.1 | Tailscale: 100.x.y.z
CLUSTER_HOST=localhost

# ── Interface onde o k3d publica as portas (server/local) ───────────────────
#   127.0.0.1 = só esta máquina | IP da VPN = só pela VPN | NUNCA 0.0.0.0 numa VPS
BIND_ADDR=127.0.0.1

# ── Portas expostas (sem portas fixas no código) ────────────────────────────
APP_PORT=5070
PROM_PORT=5080
GRAFANA_PORT=5090
KUBE_API_PORT=6550
DETECTOR_PORT=9105

# ── URLs derivadas (não editar) ─────────────────────────────────────────────
APP_URL=http://${CLUSTER_HOST}:${APP_PORT}
PROM_URL=http://${CLUSTER_HOST}:${PROM_PORT}
GRAFANA_URL=http://${CLUSTER_HOST}:${GRAFANA_PORT}

# ── Cliente remoto (ROLE=client): kubeconfig exportado pela VPS ─────────────
#   Na VPS: make kubeconfig  → copie kubeconfig-vpn.yaml para o notebook
KUBECONFIG_FILE=

# ── K3D ─────────────────────────────────────────────────────────────────────
CLUSTER_NAME=anomaly-lab
NAMESPACE=anomaly-lab
K3D_CONFIG=k3d-config.yaml

# ── Imagens Docker ──────────────────────────────────────────────────────────
APP_IMAGE=anomaly-lab/fastapi:latest
ANALYSIS_IMAGE=anomaly-lab/analysis:latest
K6_IMAGE=grafana/k6:latest

# ── Desenho experimental ────────────────────────────────────────────────────
# (listas separadas por vírgula, sem espaços: o .env é lido pelo make e pelo bash)
# repetições por cenário (qualificação: 3)
REPS=10
SCENARIOS=burst,rampup,shift
# s após o HPA voltar ao mínimo de réplicas
COOLDOWN=120
# s máximos esperando o HPA voltar ao mínimo
BASELINE_TIMEOUT=900
# aquecimento antes de CADA execução (s): carga constante com o mix da fase normal do
# cenário (k6-scripts/warmup.js), para a referência do detector online não ser feita
# de silêncio (piloto 2: 53–87% de falsos alarmes no início). Não gera CSV.
# padrão = (DETECTOR_WINDOW + DETECTOR_GAP) × DETECTOR_STEP_SECONDS = (60 + 6) × 5 = 330
# 0 = desliga (comportamento antigo). Custo: +330 s por execução.
WARMUP_SECONDS=330
# sobreposição na troca aquecimento → roteiro (s): o aquecimento desce nos últimos N s enquanto
# o roteiro sobe (1ª rampa = 30 s) → carga constante. 0 = sem sobreposição (piloto 3: alertas de 15–45 s)
WARMUP_OVERLAP=30
# reinicia a app antes de cada execução (estado limpo: 100 itens por pod). 0 = não reinicia
# (piloto 3: sem isso, 4.055 e 3.850 itens por pod → cada execução mais lenta que a anterior)
RESTART_APP=1
# semente da ordem aleatória das execuções
RANDOM_SEED=2026
# lacunas do Prometheus: zero (qualificação) | ffill
IMPUTE=zero
# critério de aceitação: 500 ms
SLO_SECONDS=0.5
# sensibilidade do SLO na Fase 3 (decisão 8), calculada na hora (os histogramas somem em 7 dias).
# Cada valor tem de ser uma borda de balde do histograma da app (0.25, 0.5, 1, 2.5 ...):
# por isso 250 ms, e não 300 ms. Colunas slo_viol_anom_250ms_pct e slo_viol_anom_1000ms_pct
SLO_SENSITIVITY_SECONDS=0.25,1
# acomodação inicial da AVALIAÇÃO da Fase 1 (s): pontos com offset < N ficam fora de F1,
# precisão, recall e MTTD, para offline e online igualmente (os detectores veem a série
# inteira). Motivo: oscilação de latência logo após a troca aquecimento → roteiro, nas 3
# execuções do piloto 4. A 1ª anomalia começa aos 150 s (burst, shift) e 175 s (rampup):
# nenhum pico é cortado. Não se aplica à Fase 3. 0 = avaliação antiga (e a da qualificação).
# Decidido em 16/out/2026, antes da Fase 1 (docs/DECISOES_METODO.md, item 11).
EVAL_SKIP_SECONDS=60
# tolerância de atraso na avaliação (s), métrica SECUNDÁRIA (f1_tol, precision_tol, recall_tol),
# offline e online: pontos normais até N s depois do fim de cada pico não contam. O F1 principal
# é sempre SEM tolerância. 30 s = janela dos sinais (rate[30s]); transbordo medido no piloto 4:
# mediana online 10–25 s, p90 de EWMA/IF ~30 s. Decisão 6 de docs/DECISOES_METODO.md
# (adotada em 18/out/2026; aguardando confirmação do orientador).
EVAL_TOLERANCE_SECONDS=30
# fim da avaliação (s depois do fim do roteiro k6): só entram os pontos até fim do k6 + N
# (burst 618, rampup 560, shift 910 s). Depois disso o CSV da Fase 1 não foi medido (o
# Prometheus repetia o último valor: pontos-fantasma). 15 s = último scrape. off = sem corte
# (números oficiais "como rodou", iguais à qualificação). Decisão 17 de docs/DECISOES_METODO.md.
EVAL_END_MARGIN_SECONDS=15

# ── Núcleos de CPU (ROLE=server com k6 na própria VPS) ──────────────────────
# Cluster e gerador de carga em núcleos separados, para o k6 não roubar CPU do HPA.
# Vazio = sem fixação (uso local). Exemplo para 8 núcleos: 0-5 e 6-7.
CLUSTER_CPUS=
LOADGEN_CPUS=

# ── Detector online (Fase 2) ────────────────────────────────────────────────
# detectores que rodam no cluster; todos publicam score e o HPA usa um deles
# aceitos (separados por vírgula, sem espaço): EWMA, IF, LOF, DBSCAN, AE, LSTM
# definidos em scripts/detectors.py (dicionário DETECTORS); o make detector-config recusa outros nomes
DETECTOR_ALGOS=EWMA,IF,LOF,DBSCAN,AE,LSTM
DETECTOR_STEP_SECONDS=5
# pontos na janela de referência (60 × 5 s = 5 min)
DETECTOR_WINDOW=60
# pontos recentes fora da referência (30 s)
DETECTOR_GAP=6
# limiar dinâmico μ + K·σ
DETECTOR_K_SIGMA=2
# piso relativo do σ (IF, LOF, AE, LSTM): σ_ef = máx(σ, piso·|μ|). Evita razões enormes
# quando a referência é quase constante (σ ≈ 0). 0 = desligado (comportamento antigo).
# DECIDIDO (16/out): 0.05. No replay da qualificação o F1 foi igual com 0 e 0.05
# (docs/validacao/piso_sigma.csv); é proteção sem custo medido. Não reajustar depois.
DETECTOR_SIGMA_FLOOR=0.05
# piso relativo na padronização das ENTRADAS (as 4 features): σ_entrada = máx(σ, piso·|μ|).
# A memória é quase constante (σ ≈ 0,005 MB) e um salto de 0,25 MB virava ~50σ (piloto 3).
# Vale para IF, LOF, DBSCAN, AE e LSTM. 0 = desligado. Validação: docs/validacao/piso_entrada.csv
DETECTOR_FEATURE_FLOOR=0.01
# anomaly_level = média dos últimos 3 alertas
DETECTOR_LEVEL_POINTS=3
# retreina o autoencoder a cada 12 passos
DETECTOR_AE_RETRAIN=12
# LSTM preditiva (6º detector, offline e online; scripts/lstm_model.py). Arquitetura FIXA:
# só mudar com base no replay da qualificação, documentando o motivo (nunca pela Fase 1 definitiva)
# pontos anteriores usados para prever o próximo (12 × 5 s = 1 min)
LSTM_SEQ_LEN=12
# unidades da camada LSTM (1 camada)
LSTM_HIDDEN=16
# épocas de treino (Adam, lote único)
LSTM_EPOCHS=30
# online: retreina a LSTM a cada 12 passos (1 min), como o AE; aumentar se o ciclo ficar lento
LSTM_RETRAIN=12
TARGET_APP=fastapi
PROMETHEUS_INCLUSTER_URL=http://prometheus.anomaly-lab.svc:9090

# ── HPA (Fase 3) ────────────────────────────────────────────────────────────
#   A = CPU 50% (atual) | B = CPU 50% + anomaly_level(HPA_B_DETECTOR)
#   C = CPU HPA_C_CPU_TARGET% (controle de custo) | D = CPU 50% + anomaly_level(HPA_D_DETECTOR)
HPA_MODE=A
HPA_MODES=A,B,C
# detector usado pelo modo B (qualquer um de DETECTOR_ALGOS: EWMA, IF, LOF, DBSCAN, AE, LSTM)
# ESCOLHA COM BASE NA FASE 1 E NÃO TROQUE DEPOIS DE VER A FASE 3
HPA_B_DETECTOR=IF
# detector do modo D (ablação opcional)
HPA_D_DETECTOR=EWMA
HPA_C_CPU_TARGET=35
# nível 1 → dobra réplicas; ≤ 1/3 → não age
ANOMALY_TARGET=500m

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=troque-esta-senha   # escolha uma senha sua; nunca a deste exemplo
