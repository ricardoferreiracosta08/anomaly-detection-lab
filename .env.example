# =============================================================================
# .env.example — copie para .env e ajuste. TODA configuração vem daqui.
#
# TOPOLOGIAS
#   1) Local (tudo na mesma máquina)
#        ROLE=local   CLUSTER_HOST=localhost   BIND_ADDR=127.0.0.1
#   2) VPS + notebook via VPN (experimento definitivo)
#        VPS     : ROLE=server  CLUSTER_HOST=<IP da VPS na VPN>  BIND_ADDR=<IP da VPS na VPN>
#        Notebook: ROLE=client  CLUSTER_HOST=<IP da VPS na VPN>  KUBECONFIG_FILE=kubeconfig-vpn.yaml
#      O cluster roda na VPS; k6 e análise rodam no notebook (sem disputar CPU com o cluster).
# =============================================================================

# ── Papel desta máquina: local | server | client ────────────────────────────
ROLE=local

# ── Endereço do cluster (do ponto de vista de quem gera carga) ──────────────
#   local: localhost | VPN WireGuard: 10.0.0.1 | Tailscale: 100.x.y.z
CLUSTER_HOST=localhost

# ── Interface onde o k3d publica as portas (server/local) ───────────────────
#   127.0.0.1 = só esta máquina | IP da VPN = só pela VPN | NUNCA 0.0.0.0 numa VPS
BIND_ADDR=127.0.0.1

# ── Portas expostas (sem portas fixas no código) ────────────────────────────
APP_PORT=5070
PROM_PORT=5080
GRAFANA_PORT=5090
KUBE_API_PORT=6550
DETECTOR_PORT=9105

# ── URLs derivadas (não editar) ─────────────────────────────────────────────
APP_URL=http://${CLUSTER_HOST}:${APP_PORT}
PROM_URL=http://${CLUSTER_HOST}:${PROM_PORT}
GRAFANA_URL=http://${CLUSTER_HOST}:${GRAFANA_PORT}

# ── Cliente remoto (ROLE=client): kubeconfig exportado pela VPS ─────────────
#   Na VPS: make kubeconfig  → copie kubeconfig-vpn.yaml para o notebook
KUBECONFIG_FILE=

# ── K3D ─────────────────────────────────────────────────────────────────────
CLUSTER_NAME=anomaly-lab
NAMESPACE=anomaly-lab
K3D_CONFIG=k3d-config.yaml

# ── Imagens Docker ──────────────────────────────────────────────────────────
APP_IMAGE=anomaly-lab/fastapi:latest
ANALYSIS_IMAGE=anomaly-lab/analysis:latest
K6_IMAGE=grafana/k6:latest

# ── Desenho experimental ────────────────────────────────────────────────────
# (listas separadas por vírgula, sem espaços: o .env é lido pelo make e pelo bash)
# repetições por cenário (qualificação: 3)
REPS=10
SCENARIOS=burst,rampup,shift
# s após o HPA voltar ao mínimo de réplicas
COOLDOWN=120
# s máximos esperando o HPA voltar ao mínimo
BASELINE_TIMEOUT=900
# semente da ordem aleatória das execuções
RANDOM_SEED=2026
# lacunas do Prometheus: zero (qualificação) | ffill
IMPUTE=zero
# critério de aceitação: 500 ms
SLO_SECONDS=0.5

# ── Núcleos de CPU (ROLE=server com k6 na própria VPS) ──────────────────────
# Cluster e gerador de carga em núcleos separados, para o k6 não roubar CPU do HPA.
# Vazio = sem fixação (uso local). Exemplo para 8 núcleos: 0-5 e 6-7.
CLUSTER_CPUS=
LOADGEN_CPUS=

# ── Detector online (Fase 2) ────────────────────────────────────────────────
# todos publicam score; o HPA usa um deles
DETECTOR_ALGOS=EWMA,IF,LOF,DBSCAN,AE
DETECTOR_STEP_SECONDS=5
# pontos na janela de referência (60 × 5 s = 5 min)
DETECTOR_WINDOW=60
# pontos recentes fora da referência (30 s)
DETECTOR_GAP=6
# limiar dinâmico μ + K·σ
DETECTOR_K_SIGMA=2
# anomaly_level = média dos últimos 3 alertas
DETECTOR_LEVEL_POINTS=3
# retreina o autoencoder a cada 12 passos
DETECTOR_AE_RETRAIN=12
TARGET_APP=fastapi
PROMETHEUS_INCLUSTER_URL=http://prometheus.anomaly-lab.svc:9090

# ── HPA (Fase 3) ────────────────────────────────────────────────────────────
#   A = CPU 50% (atual) | B = CPU 50% + anomaly_level(HPA_B_DETECTOR)
#   C = CPU HPA_C_CPU_TARGET% (controle de custo) | D = CPU 50% + anomaly_level(HPA_D_DETECTOR)
HPA_MODE=A
HPA_MODES=A,B,C
# detector usado pelo modo B (qualquer um de DETECTOR_ALGOS: EWMA, IF, LOF, DBSCAN, AE)
# ESCOLHA COM BASE NA FASE 1 E NÃO TROQUE DEPOIS DE VER A FASE 3
HPA_B_DETECTOR=IF
# detector do modo D (ablação opcional)
HPA_D_DETECTOR=EWMA
HPA_C_CPU_TARGET=35
# nível 1 → dobra réplicas; ≤ 1/3 → não age
ANOMALY_TARGET=500m

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=anomalylab2026
